# perfkit configuration. Copy to .env (git-ignored) and fill in GOOGLE_API_KEY.
#
# `npm run test:live` loads .env automatically. The server itself does not:
# give the same variables to your MCP client (for example `claude mcp add ... -e NAME=value`).
# Variables already set in your shell take precedence over .env.
# Never commit a real key. See docs/google-setup.md for how to create and restrict one.

# Required: a Google API key with the PageSpeed Insights API and Chrome UX Report API enabled.
GOOGLE_API_KEY=your-google-api-key

# Optional. The values shown are the defaults; uncomment a line to override it.

# Upstream timeouts (per attempt, ms) and retries (on 429, 5xx, timeouts, network failures).
# PERFKIT_PSI_TIMEOUT_MS=60000
# PERFKIT_PSI_RETRIES=1
# PERFKIT_CRUX_TIMEOUT_MS=10000
# PERFKIT_CRUX_RETRIES=3

# Overall time budget for one performance_overview call (ms).
# PERFKIT_OVERVIEW_BUDGET_MS=75000

# In-memory cache lifetimes (seconds) and size. 0 disables caching.
# PERFKIT_CACHE_TTL_PAGESPEED_SECONDS=1800
# PERFKIT_CACHE_TTL_CRUX_CURRENT_SECONDS=43200
# PERFKIT_CACHE_TTL_CRUX_HISTORY_SECONDS=604800
# PERFKIT_CACHE_MAX_ENTRIES=500

# 1 also rejects URLs whose host does not resolve or resolves to a non-public IP address.
# PERFKIT_DNS_CHECK=0
